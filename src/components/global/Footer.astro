---
import Logo from './Logo.astro';
import Button from '@components/ui/Button.astro';
import Container from '@components/layout/Container.astro';
import { SITE } from '@lib/constants';
---

<footer class="relative border-t border-surface-border">
  <!-- CTA Section -->
  <div class="relative py-section overflow-hidden">
    <!-- Subtle gradient background -->
    <div class="absolute inset-0 bg-gradient-to-b from-surface to-surface-elevated"></div>

    <div class="relative max-w-container mx-auto px-6 lg:px-8 text-center">
      <p class="text-body-sm text-content font-medium mb-4">Available for projects</p>
      <h2 class="font-display text-display-md lg:text-display-lg max-w-4xl mx-auto mb-8" style="font-style: italic;">
        Ready to make your data work for AI? Let's build something extraordinary.
      </h2>
      <Button href="/contact" variant="primary" size="lg">
        Book a Free Call
      </Button>

    </div>
  </div>

  <!-- Site Links -->
  <div class="border-t border-surface-border py-10">
    <div class="max-w-container mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-body-sm">
        <div>
          <p class="text-content-muted font-medium mb-3 uppercase tracking-wider text-xs">Services</p>
          <ul class="space-y-2">
            <li><a href="/what-we-do" class="text-content-muted hover:text-content transition-colors">What We Do</a></li>
            <li><a href="/how-we-work" class="text-content-muted hover:text-content transition-colors">How We Work</a></li>
            <li><a href="/how-we-price" class="text-content-muted hover:text-content transition-colors">How We Price</a></li>
            <li><a href="/architecture" class="text-content-muted hover:text-content transition-colors">AI Architecture</a></li>
            <li><a href="/data-platforms" class="text-content-muted hover:text-content transition-colors">Data Platforms</a></li>
          </ul>
        </div>
        <div>
          <p class="text-content-muted font-medium mb-3 uppercase tracking-wider text-xs">Platforms</p>
          <ul class="space-y-2">
            <li><a href="/tachyon" class="text-content-muted hover:text-content transition-colors">Tachyon</a></li>
            <li><a href="/smart-lakehouse-ionos" class="text-content-muted hover:text-content transition-colors">Smart Lakehouse</a></li>
          </ul>
        </div>
        <div>
          <p class="text-content-muted font-medium mb-3 uppercase tracking-wider text-xs">Company</p>
          <ul class="space-y-2">
            <li><a href="/about" class="text-content-muted hover:text-content transition-colors">About</a></li>
            <li><a href="/trust-security" class="text-content-muted hover:text-content transition-colors">Trust & Security</a></li>
            <li><a href="/insights" class="text-content-muted hover:text-content transition-colors">Insights</a></li>
            <li><a href="/contact" class="text-content-muted hover:text-content transition-colors">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="text-content-muted font-medium mb-3 uppercase tracking-wider text-xs">Tools</p>
          <ul class="space-y-2">
            <li><a href="/ai-readiness-assessment" class="text-content-muted hover:text-content transition-colors">AI Readiness Assessment</a></li>
            <li><a href="/glossary" class="text-content-muted hover:text-content transition-colors">AI & Data Glossary</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-surface-border py-6">
    <div class="max-w-container mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-body-xs text-content-muted">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <nav class="flex items-center gap-6" aria-label="Legal">
        <a href="/privacy" class="hover:text-content transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-content transition-colors">Terms of Service</a>
      </nav>
    </div>
  </div>
</footer>
