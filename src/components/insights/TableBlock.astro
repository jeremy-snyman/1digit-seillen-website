---
interface Props {
  columns: string[];
  rows: string[][];
  caption?: string;
}

const { columns, rows, caption } = Astro.props;

// Identify a "Status" column so its punchy values render as a coloured pill.
const statusIdx = columns.findIndex((c) => c.trim().toLowerCase() === 'status');

// Per-column max content length. Short columns shrink to fit; long/prose columns
// wrap and share the remaining width — so a long status pill never gets clipped.
const colMaxLen = columns.map((col, ci) =>
  Math.max(col.length, ...rows.map((r) => (r[ci] || '').length)),
);
// Short columns shrink to their content; the longest prose column wraps and
// absorbs the slack. The Status column always shrinks so its pills never clip.
const longestIdx = colMaxLen.indexOf(Math.max(...colMaxLen));
const shrink = colMaxLen.map((len, ci) => ci !== longestIdx && (len <= 28 || ci === statusIdx));

// Only the short, definite statuses become pills; verbose caveats stay as quiet
// plain text so they can wrap and never clip.
function statusPill(value: string): string | null {
  const v = value.toLowerCase();
  if (v.includes('in force')) return 'bg-success/10 text-success border border-success/20';
  if (v.includes('live')) return 'bg-accent/15 text-accent border border-accent/25';
  return null; // Agreed / pending / consultation / expected → plain muted text
}
---

<div class="my-8 -mx-4 sm:mx-0 overflow-x-auto">
  <table class="w-full min-w-[640px] border-collapse text-left">
    <thead>
      <tr class="border-b border-surface-border">
        {columns.map((col, ci) => (
          <th class:list={['text-label-sm uppercase tracking-wide text-content-muted font-semibold py-3 px-4 align-bottom', shrink[ci] && 'whitespace-nowrap w-px']}>
            {col}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-surface-border/60 align-top">
          {row.map((cell, ci) => (
            <td class:list={['py-3.5 px-4 text-body-sm text-content-secondary leading-relaxed', shrink[ci] && 'whitespace-nowrap w-px']}>
              {ci === statusIdx && cell && statusPill(cell) ? (
                <span class:list={['inline-block rounded-full px-2.5 py-1 text-xs font-medium whitespace-nowrap', statusPill(cell)]}>
                  {cell}
                </span>
              ) : ci === statusIdx && cell ? (
                <span class="text-content-muted text-xs">{cell}</span>
              ) : ci === 0 ? (
                <span class="text-content font-medium whitespace-nowrap">{cell}</span>
              ) : (
                cell
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
  {caption && (
    <p class="text-body-xs text-content-muted mt-3 px-4 sm:px-0">{caption}</p>
  )}
</div>
