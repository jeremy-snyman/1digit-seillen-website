---
const threats = [
  { label: 'Prompt Injection', angle: 270 },
  { label: 'Data Leakage', angle: 330 },
  { label: 'Hallucination', angle: 30 },
  { label: 'Output Bias', angle: 90 },
  { label: 'Model Drift', angle: 150 },
  { label: 'Unauthorized Access', angle: 210 },
];

const cx = 240;
const cy = 220;
const radius = 150;

const nodes = threats.map((t) => {
  const rad = (t.angle * Math.PI) / 180;
  return {
    ...t,
    x: cx + radius * Math.cos(rad),
    y: cy + radius * Math.sin(rad),
  };
});
---

<div class="ai-risk-network" aria-label="AI risk network diagram with 6 threat vectors and containment boundary">
  <svg viewBox="0 0 480 440" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-lg mx-auto h-auto">
    <defs>
      <radialGradient id="ai-core-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="rgb(var(--color-signal-blue) / 0.15)" />
        <stop offset="100%" stop-color="transparent" />
      </radialGradient>
    </defs>

    {/* Containment boundary */}
    <circle cx={cx} cy={cy} r={radius + 30}
            stroke="rgb(var(--color-signal-emerald) / 0.25)"
            stroke-width="1.5"
            stroke-dasharray="8 6"
            fill="none"
            class="containment-ring" />

    {/* Inner containment */}
    <circle cx={cx} cy={cy} r={radius + 15}
            stroke="rgb(var(--color-signal-emerald) / 0.1)"
            stroke-width="1"
            stroke-dasharray="4 4"
            fill="none" />

    {/* Connection lines from center to each threat */}
    {nodes.map((node) => (
      <line x1={cx} y1={cy} x2={node.x} y2={node.y}
            stroke="rgb(var(--color-content-muted) / 0.12)"
            stroke-width="1"
            stroke-dasharray="4 4" />
    ))}

    {/* Core glow */}
    <circle cx={cx} cy={cy} r="60" fill="url(#ai-core-glow)" />

    {/* Central AI node */}
    <circle cx={cx} cy={cy} r="34"
            fill="rgb(var(--glass-bg) / 0.7)"
            stroke="rgb(var(--color-signal-blue) / 0.4)"
            stroke-width="1.5"
            class="ai-core" />

    {/* Brain/AI icon in center */}
    <g transform={`translate(${cx - 14}, ${cy - 14})`}>
      {/* Simple brain shape */}
      <path d="M14 2 C8 2 4 6 4 10 C2 10 0 12 0 15 C0 18 2 20 4 20.5 C4 24 8 27 14 27 C20 27 24 24 24 20.5 C26 20 28 18 28 15 C28 12 26 10 24 10 C24 6 20 2 14 2Z"
            fill="none"
            stroke="rgb(var(--color-signal-blue) / 0.6)"
            stroke-width="1.2" />
      {/* Center line */}
      <line x1="14" y1="6" x2="14" y2="23"
            stroke="rgb(var(--color-signal-blue) / 0.3)"
            stroke-width="0.8" />
      {/* Neural connections */}
      <path d="M8 10 Q14 13 20 10" fill="none" stroke="rgb(var(--color-signal-blue) / 0.3)" stroke-width="0.8" />
      <path d="M6 16 Q14 19 22 16" fill="none" stroke="rgb(var(--color-signal-blue) / 0.3)" stroke-width="0.8" />
    </g>

    {/* Threat nodes */}
    {nodes.map((node) => (
      <g class="threat-node">
        {/* Node circle */}
        <circle cx={node.x} cy={node.y} r="22"
                fill="rgb(var(--glass-bg) / 0.6)"
                stroke="rgb(var(--color-signal-amber) / 0.4)"
                stroke-width="1.5" />
        {/* Warning icon */}
        <text x={node.x} y={node.y + 1}
              text-anchor="middle" dominant-baseline="central"
              fill="rgb(var(--color-signal-amber) / 0.7)"
              font-size="16" font-weight="bold"
              font-family="var(--font-sans, Inter, sans-serif)">!</text>
      </g>
    ))}

    {/* Labels */}
    {nodes.map((node) => {
      const labelRadius = radius + 52;
      const rad = (node.angle * Math.PI) / 180;
      const lx = cx + labelRadius * Math.cos(rad);
      const ly = cy + labelRadius * Math.sin(rad);
      return (
        <text x={lx} y={ly}
              text-anchor="middle" dominant-baseline="central"
              fill="rgb(var(--color-content-secondary))"
              font-size="11" font-weight="500"
              font-family="var(--font-sans, Inter, sans-serif)">
          {node.label}
        </text>
      );
    })}

    {/* "CONTAINMENT BOUNDARY" label */}
    <text x={cx} y="28"
          text-anchor="middle"
          fill="rgb(var(--color-signal-emerald) / 0.6)"
          font-size="9" font-weight="600" letter-spacing="2"
          font-family="var(--font-sans, Inter, sans-serif)">
      CONTAINMENT BOUNDARY
    </text>
  </svg>
</div>

<style>
  .threat-node {
    transition: filter 0.3s ease;
  }

  .threat-node:hover {
    filter: drop-shadow(0 0 10px rgb(var(--color-signal-amber) / 0.3));
  }

  .ai-core {
    transition: filter 0.3s ease;
  }

  .ai-core:hover {
    filter: drop-shadow(0 0 14px rgb(var(--color-signal-blue) / 0.3));
  }

  .containment-ring {
    animation: containment-rotate 60s linear infinite;
    transform-origin: center;
  }

  @keyframes containment-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes threat-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .threat-node {
    animation: threat-pulse 3s ease-in-out infinite;
  }

  .threat-node:nth-child(8) { animation-delay: 0s; }
  .threat-node:nth-child(9) { animation-delay: 0.5s; }
  .threat-node:nth-child(10) { animation-delay: 1s; }
  .threat-node:nth-child(11) { animation-delay: 1.5s; }
  .threat-node:nth-child(12) { animation-delay: 2s; }
  .threat-node:nth-child(13) { animation-delay: 2.5s; }
</style>
