---
const steps = [
  { num: '01', label: 'Action Logged' },
  { num: '02', label: 'Tamper-Sealed' },
  { num: '03', label: 'Lineage Traced' },
  { num: '04', label: 'Version Tracked' },
  { num: '05', label: 'Report Generated' },
];
---

<div class="audit-trail-flow">
  <div class="flex items-center justify-center gap-2 sm:gap-3 md:gap-4 flex-wrap sm:flex-nowrap">
    {steps.map((step, i) => (
      <>
        <div class="flex flex-col items-center gap-2 shrink-0">
          <div class="audit-node relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center">
            <span class="text-label-md sm:text-label-lg font-semibold text-signal-purple">{step.num}</span>
          </div>
          <span class="text-body-xs sm:text-body-sm text-content-secondary text-center max-w-[90px] sm:max-w-[110px] leading-tight">{step.label}</span>
        </div>
        {i < steps.length - 1 && (
          <div class="shrink-0 mb-6 sm:mb-8">
            <svg width="32" height="12" viewBox="0 0 32 12" fill="none" class="audit-arrow">
              <line x1="0" y1="6" x2="24" y2="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" />
              <path d="M22 2 L28 6 L22 10" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        )}
      </>
    ))}
  </div>
</div>

<style>
  .audit-node {
    background: rgb(var(--glass-bg) / var(--glass-bg-alpha));
    border: 1.5px solid rgb(var(--color-signal-purple) / 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .audit-node:hover {
    border-color: rgb(var(--color-signal-purple) / 0.6);
    box-shadow: 0 0 20px rgb(var(--color-signal-purple) / 0.15);
  }

  .audit-arrow {
    color: rgb(var(--color-signal-purple) / 0.4);
  }

  /* Subtle pulse animation on the flow */
  @keyframes audit-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.7; }
  }

  .audit-arrow {
    animation: audit-pulse 3s ease-in-out infinite;
  }

  .audit-trail-flow > div > div:nth-child(1) .audit-arrow { animation-delay: 0s; }
  .audit-trail-flow > div > div:nth-child(2) .audit-arrow { animation-delay: 0.4s; }
  .audit-trail-flow > div > div:nth-child(3) .audit-arrow { animation-delay: 0.8s; }
  .audit-trail-flow > div > div:nth-child(4) .audit-arrow { animation-delay: 1.2s; }
</style>
