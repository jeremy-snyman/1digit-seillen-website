---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/layout/Section.astro';
import Container from '@components/layout/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ScrollReveal from '@components/interactive/ScrollReveal.astro';
import GlassCard from '@components/ui/GlassCard.astro';
import Icon from '@components/ui/Icon.astro';
import Button from '@components/ui/Button.astro';
import Badge from '@components/ui/Badge.astro';
import Tag from '@components/ui/Tag.astro';
import FeatureList from '@components/content/FeatureList.astro';
import StatHighlight from '@components/content/StatHighlight.astro';
import Accordion from '@components/interactive/Accordion.astro';
import AccordionItem from '@components/interactive/AccordionItem.astro';
import CostComparisonTable from '@components/content/CostComparisonTable.astro';
import CostCalculatorTeaser from '@components/content/CostCalculatorTeaser.astro';
import {
  heroTagline,
  heroPartnershipText,
  techStackTags,
  costProblems,
  statHighlights,
  differentiators,
  comparisonRows,
  comparisonCallout,
  comparisonDisclaimer,
  architectureFeatures,
  archLayers,
  benefits,
  useCases,
} from '@content/data/smart-lakehouse';

const archColorMap: Record<string, { numBg: string; numBorder: string; numText: string; techText: string }> = {
  amber: { numBg: 'bg-signal-amber/15', numBorder: 'border-signal-amber/30', numText: 'text-signal-amber', techText: 'text-signal-amber' },
  purple: { numBg: 'bg-signal-purple/15', numBorder: 'border-signal-purple/30', numText: 'text-signal-purple', techText: 'text-signal-purple' },
  blue: { numBg: 'bg-signal-blue/15', numBorder: 'border-signal-blue/30', numText: 'text-signal-blue', techText: 'text-signal-blue' },
  emerald: { numBg: 'bg-signal-emerald/15', numBorder: 'border-signal-emerald/30', numText: 'text-signal-emerald', techText: 'text-signal-emerald' },
};

const title = 'Smart Lakehouse on IONOS — EU Sovereign Cloud Data';
const description = 'Enterprise data lakehouse on European sovereign cloud — IONOS. 40–60% lower cost than AWS, Azure, or GCP, with full EU data sovereignty and GDPR compliance.';

const smartLakehouseFAQ = [
  {
    question: 'What is a Smart Lakehouse?',
    answer: 'A Smart Lakehouse is a unified data architecture that combines the scalability and format flexibility of a data lake with the structure and query performance of a data warehouse. It serves as the foundation for both analytics and AI workloads from a single platform.',
  },
  {
    question: 'Why IONOS and not AWS, Azure, or GCP?',
    answer: 'IONOS is a European sovereign cloud provider operating exclusively within EU data centre infrastructure. This guarantees data residency within EU borders — a regulatory requirement for many European enterprises under GDPR. IONOS infrastructure also delivers 40–60% lower cost than equivalent hyperscaler services.',
  },
  {
    question: 'What cost savings can we expect compared to hyperscalers?',
    answer: 'Based on client deployments, enterprises typically achieve 40–60% lower infrastructure cost compared to equivalent AWS, Azure, or GCP configurations. The largest savings come from storage, compute, and egress — areas where hyperscalers charge premium rates at enterprise scale.',
  },
  {
    question: 'How does migration from an existing data warehouse work?',
    answer: 'Migration typically follows three phases: assessment of current architecture and data volumes, parallel-build of the Smart Lakehouse environment, and cutover with a defined rollback plan. The Tachyon platform handles data ingestion and transformation during migration. Typical engagement: 6–16 weeks.',
  },
  {
    question: 'Is the Smart Lakehouse suitable for regulated industries?',
    answer: 'Yes. The Smart Lakehouse on IONOS is specifically designed for regulated industries requiring data sovereignty, audit trails, and compliance documentation. It includes GDPR alignment, ISO 27001-compatible security controls, and role-based access controls as standard.',
  },
];

const useCaseAccentMap: Record<string, { iconBg: string; iconColor: string; borderColor: string; glowClass: string }> = {
  purple: {
    iconBg: 'bg-signal-purple/15 border border-signal-purple/25',
    iconColor: 'text-signal-purple',
    borderColor: 'border-t-2 border-signal-purple/40',
    glowClass: 'phase-glow-purple',
  },
  blue: {
    iconBg: 'bg-signal-blue/15 border border-signal-blue/25',
    iconColor: 'text-signal-blue',
    borderColor: 'border-t-2 border-signal-blue/40',
    glowClass: 'phase-glow-blue',
  },
  emerald: {
    iconBg: 'bg-signal-emerald/15 border border-signal-emerald/25',
    iconColor: 'text-signal-emerald',
    borderColor: 'border-t-2 border-signal-emerald/40',
    glowClass: 'phase-glow-green',
  },
  amber: {
    iconBg: 'bg-signal-amber/15 border border-signal-amber/25',
    iconColor: 'text-signal-amber',
    borderColor: 'border-t-2 border-signal-amber/40',
    glowClass: 'phase-glow-amber',
  },
};
---

<PageLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"SoftwareApplication","name":"Smart Lakehouse on IONOS","applicationCategory":"BusinessApplication","operatingSystem":"Cloud","description":"Enterprise data lakehouse on European sovereign cloud powered by IONOS. 40–60% lower infrastructure cost than hyperscaler equivalents, with full EU data sovereignty.","provider":{"@id":"https://1digit.co.uk/#org"},"url":"https://1digit.co.uk/smart-lakehouse-ionos","featureList":["EU data sovereignty","GDPR compliance","40–60% cost reduction vs hyperscalers","Smart Lakehouse architecture","IONOS cloud infrastructure"]})} />
  </Fragment>

  {/* ── S1: Hero ── */}
  <section class="force-dark-hero relative min-h-[85vh] md:min-h-[90vh] flex items-center overflow-hidden">
    {/* Background layers */}
    <div class="absolute inset-0 z-0">
      {/* Hero background image */}
      <div class="absolute inset-0 hero-bg-image" style="background: url('/images/smart-lakehouse/hero-bg.jpg') center/cover no-repeat;"></div>
      {/* Surface overlay for text readability */}
      <div class="absolute inset-0" style="background: rgb(var(--color-surface) / 0.5);"></div>
      {/* Top gradient fade */}
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgb(var(--color-surface)) 0%, transparent 25%);"></div>
      {/* Bottom gradient fade */}
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgb(var(--color-surface)) 0%, transparent 35%);"></div>
      {/* Left gradient for text contrast */}
      <div class="absolute inset-0" style="background: linear-gradient(to left, rgb(var(--color-surface) / 0.85) 0%, transparent 50%);"></div>
      {/* Ambient glow orb */}
      <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-glow-steel/15 rounded-full blur-[140px] pointer-events-none"></div>
    </div>

    <div class="relative z-10 w-full">
      <Container>
        <ScrollReveal>
          <div class="max-w-3xl pt-36 pb-24">
            <div class="flex gap-3 mb-4">
              <Badge variant="accent">PARTNERSHIP</Badge>
              <Badge>IONOS</Badge>
            </div>
            <h1 class="text-display-lg md:text-display-lg lg:text-display-xl font-display mt-4 mb-2">
              Tachyon <em class="font-serif italic">Intelligence</em> Platform
            </h1>
            {/* Four-color gradient line */}
            <div class="four-color-line mb-6"></div>
            <p class="text-body-lg text-content-secondary max-w-2xl mb-4">
              {heroTagline}
            </p>
            <p class="text-body-md text-content-muted max-w-2xl mb-8">
              {heroPartnershipText}
            </p>

            {/* Tech stack tags */}
            <div class="flex flex-wrap gap-2 mb-8">
              {techStackTags.map((tag) => (
                <Tag>{tag}</Tag>
              ))}
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <Button variant="primary" size="lg" href="#cost-comparison">Compare Costs</Button>
              <Button variant="outline" size="lg" href="/contact">Speak to Us</Button>
            </div>
          </div>
        </ScrollReveal>
      </Container>
    </div>

    {/* Scroll indicator */}
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 hidden md:flex flex-col items-center gap-2 text-content-muted">
      <span class="text-body-xs">Scroll to explore</span>
      <div class="scroll-indicator-mouse w-6 h-10 rounded-full border-2 border-content-muted/40 flex items-start justify-center p-1.5">
        <div class="scroll-indicator-dot w-1.5 h-1.5 rounded-full bg-content-muted"></div>
      </div>
    </div>
  </section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S2: Core Commercial Narrative ── */}
  <Section background="elevated">
    <Container>
      <div class="relative">
        {/* Amber glow orb */}
        <div class="absolute top-1/4 right-0 w-[400px] h-[400px] bg-signal-amber/8 rounded-full blur-[120px] pointer-events-none" style="animation: drift 20s ease-in-out infinite;"></div>

        <ScrollReveal>
          <SectionHeading
            align="center"
            badge="THE COST PROBLEM"
            heading="Why Organisations Move Away"
            description="When data grows, cost grows faster. Hyperscaler data warehousing is powerful, but the economics work against you at scale."
          />
        </ScrollReveal>

        {/* Cost escalation image */}
        <ScrollReveal delay={100}>
          <div class="relative mt-10 max-w-3xl mx-auto">
            <div class="absolute -inset-4 bg-signal-amber/8 rounded-card blur-2xl pointer-events-none"></div>
            <img
              src="/images/smart-lakehouse/cost-escalation.jpg"
              alt="Cost escalation curve showing hyperscaler costs accelerating at scale"
              class="relative rounded-card w-full"
              loading="lazy"
            />
          </div>
        </ScrollReveal>

        {/* 4 problem cards in a row */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
          {costProblems.map((problem, index) => (
            <ScrollReveal delay={index * 80}>
              <GlassCard hover padding="md" class="h-full">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-signal-amber/15 border border-signal-amber/25 flex items-center justify-center shrink-0">
                    <Icon name={problem.icon} size={20} class="text-signal-amber" />
                  </div>
                  <div>
                    <p class="text-label-md text-content-muted mb-1">{String(index + 1).padStart(2, '0')}</p>
                    <h3 class="text-heading-xs font-semibold mb-2">{problem.title}</h3>
                    <p class="text-body-sm text-content-secondary">{problem.description}</p>
                  </div>
                </div>
              </GlassCard>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S3: The Tachyon Difference ── */}
  <Section>
    <Container>
      <ScrollReveal>
        <SectionHeading
          align="center"
          badge="THE TACHYON DIFFERENCE"
          heading="Built for Technical and Financial Scale"
        />
      </ScrollReveal>

      {/* Stat highlights */}
      <div class="relative mt-12">
        {/* Ambient glow behind stats */}
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-signal-emerald/10 rounded-full blur-[120px] pointer-events-none ambient-glow"></div>

        <div class="relative grid grid-cols-1 md:grid-cols-3 gap-6">
          {statHighlights.map((stat, index) => (
            <ScrollReveal delay={index * 100}>
              <GlassCard padding="lg" class="h-full">
                <StatHighlight
                  value={stat.value}
                  label={stat.label}
                  description={stat.description}
                  size="lg"
                  valueClass="text-signal-emerald"
                />
              </GlassCard>
            </ScrollReveal>
          ))}
        </div>
      </div>

      {/* Differentiators */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mt-16">
        <ScrollReveal delay={300}>
          <FeatureList items={differentiators} />
        </ScrollReveal>
        <ScrollReveal delay={400}>
          <div class="relative">
            <div class="absolute -inset-4 bg-signal-emerald/8 rounded-card blur-2xl pointer-events-none"></div>
            <img
              src="/images/smart-lakehouse/cost-stability.jpg"
              alt="Infrastructure cost stability, predictable linear scaling vs hyperscaler escalation"
              class="relative rounded-card w-full"
              loading="lazy"
            />
          </div>
        </ScrollReveal>
      </div>

      <ScrollReveal delay={500}>
        <p class="text-body-lg text-content-secondary text-center mt-12 max-w-2xl mx-auto">
          Not cheap cloud. <em class="text-content font-semibold">Cost-efficient enterprise infrastructure.</em>
        </p>
      </ScrollReveal>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S4: Cost Comparison Table ── */}
  <Section background="elevated" id="cost-comparison">
    <Container>
      <ScrollReveal>
        <SectionHeading
          align="center"
          badge="COST COMPARISON"
          heading="Indicative Cost Comparison"
        />
      </ScrollReveal>

      <ScrollReveal delay={200}>
        <div class="relative mt-12">
          {/* Blue glow orb behind table */}
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-signal-blue/8 rounded-full blur-[120px] pointer-events-none" style="animation: drift 22s ease-in-out infinite;"></div>
          <div class="relative shimmer-border rounded-card">
            <CostComparisonTable
              rows={comparisonRows}
              callout={comparisonCallout}
              disclaimer={comparisonDisclaimer}
            />
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={400}>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Get a Tailored Estimate</Button>
          <Button variant="outline" size="lg" href="#architecture">View Architecture</Button>
        </div>
      </ScrollReveal>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S5: Architecture & Capability ── */}
  <Section id="architecture">
    <Container>
      <ScrollReveal>
        <SectionHeading
          badge="ARCHITECTURE"
          heading="What You Get"
        />
      </ScrollReveal>

      {/* Architecture image + numbered layer descriptions */}
      <div class="relative grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-16 items-center mt-12">
        {/* Purple glow orb */}
        <div class="absolute top-1/3 left-1/4 w-[400px] h-[400px] bg-signal-purple/8 rounded-full blur-[120px] pointer-events-none" style="animation: drift 20s ease-in-out infinite;"></div>

        {/* Left: Architecture diagram (constrained) */}
        <ScrollReveal delay={100}>
          <div class="relative max-w-xs lg:max-w-sm mx-auto lg:mx-0">
            <div class="absolute -inset-4 bg-signal-purple/6 rounded-card blur-2xl pointer-events-none"></div>
            <img
              src="/images/smart-lakehouse/architecture-diagram.jpg"
              alt="Tachyon Intelligence Platform architecture, 6 layers from IONOS infrastructure to Superset analytics"
              class="relative rounded-card w-full max-h-[560px] object-contain"
              loading="lazy"
            />
          </div>
        </ScrollReveal>

        {/* Right: Numbered layer descriptions */}
        <div class="space-y-5">
          {archLayers.map((layer, i) => {
            const colors = archColorMap[layer.color];
            return (
              <ScrollReveal delay={i * 80}>
                <div class="flex gap-4 items-start">
                  <div class:list={['w-8 h-8 rounded-full border flex items-center justify-center shrink-0 text-body-sm font-semibold', colors.numBg, colors.numBorder, colors.numText]}>
                    {layer.number}
                  </div>
                  <div>
                    <h4 class="text-heading-xs font-semibold">
                      {layer.title} <span class:list={['font-normal', colors.techText]}>// {layer.tech}</span>
                    </h4>
                    <p class="text-body-sm text-content-secondary mt-1">{layer.description}</p>
                  </div>
                </div>
              </ScrollReveal>
            );
          })}
        </div>
      </div>

      {/* Benefits grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
        {benefits.map((benefit, index) => (
          <ScrollReveal delay={index * 100}>
            <GlassCard hover padding="lg" class="h-full">
              <div class="w-12 h-12 rounded-xl bg-signal-purple/15 border border-signal-purple/25 flex items-center justify-center mb-4">
                <Icon name={benefit.icon} size={24} class="text-signal-purple" />
              </div>
              <h3 class="text-heading-xs font-semibold mb-2">{benefit.title}</h3>
              <p class="text-body-md text-content-secondary">{benefit.description}</p>
            </GlassCard>
          </ScrollReveal>
        ))}
      </div>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S6: Use Cases ── */}
  <Section background="elevated">
    <Container>
      <ScrollReveal>
        <SectionHeading
          badge="USE CASES"
          heading="Built For"
          description="The Tachyon Intelligence Platform is designed for organisations that need cost-efficient data infrastructure for analytics and AI."
        />
      </ScrollReveal>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
        {useCases.map((uc, index) => {
          const accent = useCaseAccentMap[uc.accentColor];
          return (
            <ScrollReveal delay={index * 100}>
              <GlassCard hover padding="lg" class:list={['h-full', accent.borderColor, accent.glowClass]}>
                <div class:list={['w-10 h-10 rounded-lg flex items-center justify-center mb-3', accent.iconBg]}>
                  <Icon name={uc.icon} size={20} class={accent.iconColor} />
                </div>
                <h3 class="text-heading-xs font-semibold mb-3">{uc.title}</h3>
                <p class="text-body-md text-content-secondary">{uc.description}</p>
              </GlassCard>
            </ScrollReveal>
          );
        })}
      </div>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S7: Cost Calculator Teaser ── */}
  <Section>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <ScrollReveal>
          <Badge>COMING SOON</Badge>
          <h2 class="text-display-md lg:text-display-lg font-display mt-4 mb-6">
            Personalised Cost Calculator
          </h2>
          <p class="text-body-lg text-content-secondary max-w-lg mb-4">
            Model your data infrastructure costs and see an indicative comparison between hyperscaler-based warehousing and the Tachyon Intelligence Platform on IONOS.
          </p>
          <p class="text-body-md text-content-muted max-w-lg mb-8">
            Enter your data volumes, query patterns, and workload types to receive a tailored cost estimate.
          </p>
          <Button variant="primary" size="lg" href="/contact">Get an Estimate Now</Button>
        </ScrollReveal>

        <ScrollReveal delay={200}>
          <CostCalculatorTeaser />
        </ScrollReveal>
      </div>
    </Container>
  </Section>

  <div class="wwd-section-divider" aria-hidden="true"></div>

  {/* ── S8: Bottom CTA ── */}
  <Section background="elevated">
    <Container>
      <ScrollReveal>
        <div class="relative text-center">
          {/* Multi-color ambient glow orbs */}
          <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[250px] bg-signal-blue/8 rounded-full blur-[120px] pointer-events-none" style="animation: drift 20s ease-in-out infinite;"></div>
          <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[300px] h-[200px] bg-signal-purple/8 rounded-full blur-[120px] pointer-events-none" style="animation: mesh-drift-1 25s ease-in-out infinite;"></div>

          <div class="relative shimmer-border glass-card p-8 md:p-12 rounded-card max-w-2xl mx-auto">
            <SectionHeading
              align="center"
              heading="Ready to Reduce Your Data Infrastructure Costs?"
              description="Compare the Tachyon Intelligence Platform against your current hyperscaler spend."
            />
            <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
              <Button variant="primary" size="lg" href="/contact">Compare Your Costs</Button>
              <Button variant="outline" size="lg" href="/tachyon">Explore Tachyon Engine</Button>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </Container>
  </Section>

  <!-- FAQ Section -->
  <Section padding="default">
    <Container size="narrow">
      <ScrollReveal>
        <SectionHeading
          align="center"
          badge="FAQ"
          heading="Common Questions About Smart Lakehouse"
          description="Everything you need to know before starting an infrastructure conversation."
        />
      </ScrollReveal>
      <div class="mt-10">
        <ScrollReveal>
          <Accordion>
            {smartLakehouseFAQ.map((item) => (
              <AccordionItem question={item.question} answer={item.answer} />
            ))}
          </Accordion>
        </ScrollReveal>
      </div>
    </Container>
  </Section>

  {/* FAQPage Schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": smartLakehouseFAQ.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
    })),
  })} />

</PageLayout>
