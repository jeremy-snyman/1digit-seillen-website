---
import InsightLayout from '@layouts/InsightLayout.astro';
import { getInsightBySlug, getPublishedInsights } from '@content/data/insights/index';

export function getStaticPaths() {
  return getPublishedInsights().map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const article = slug ? getInsightBySlug(slug) : undefined;

if (!article) {
  return Astro.redirect('/insights');
}
---

<InsightLayout article={article} />
