---
import InsightLayout from '@layouts/InsightLayout.astro';
import { getInsightBySlugFresh } from '@content/data/insights/index';

export const prerender = false;

const { slug } = Astro.params;
const article = slug ? getInsightBySlugFresh(slug) : undefined;

if (!article) {
  return Astro.redirect('/insights');
}
---

<InsightLayout article={article} />
