---
import PageLayout from '@layouts/PageLayout.astro';
import Section from '@components/layout/Section.astro';
import Container from '@components/layout/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ScrollReveal from '@components/interactive/ScrollReveal.astro';
import GlassCard from '@components/ui/GlassCard.astro';
import Icon from '@components/ui/Icon.astro';
import Badge from '@components/ui/Badge.astro';
import ContactForm from '@components/forms/ContactForm';

const title = 'Contact 1Digit — AI & Data Consulting';
const description = 'Contact 1Digit to discuss your enterprise AI or data engineering requirements. Email hello@1digit.co.uk or book a 30-minute scoping call — no hard sell.';
---

<PageLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"ContactPage","name":"Contact 1Digit","url":"https://1digit.co.uk/contact","description":"Contact 1Digit to discuss enterprise AI architecture and data engineering engagements.","mainEntity":{"@context":"https://schema.org","@type":"Organization","@id":"https://1digit.co.uk/#org","name":"1Digit","url":"https://1digit.co.uk","email":"hello@1digit.co.uk","telephone":"+442082424055","contactPoint":[{"@type":"ContactPoint","email":"hello@1digit.co.uk","telephone":"+442082424055","contactType":"sales","availableLanguage":"English"}]}})} />
  </Fragment>
  <Section class="pt-32 pb-8">
    <Container>
      <ScrollReveal>
        <Badge variant="accent">CONTACT</Badge>
        <h1 class="text-display-lg lg:text-display-xl font-display mt-4 mb-0">
          Let's <em class="font-serif italic">Talk</em> ...
        </h1>
      </ScrollReveal>
    </Container>
  </Section>

  <Section background="elevated" padding="sm">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10">
        <ScrollReveal>
          <ContactForm client:idle />
        </ScrollReveal>

        <ScrollReveal delay={200}>
          <div class="space-y-6">
            <GlassCard padding="lg">
              <h3 class="text-heading-xs font-semibold mb-4">Get in Touch</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <Icon name="mail" size={18} class="text-content mt-1" />
                  <div>
                    <p class="text-body-sm font-medium">Email</p>
                    <a href="mailto:hello@1digit.co.uk" class="text-body-sm text-content hover:underline">hello@1digit.co.uk</a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="phone" size={18} class="text-content mt-1" />
                  <div>
                    <p class="text-body-sm font-medium">Phone</p>
                    <a href="tel:+442082424055" class="text-body-sm text-content hover:underline">+44 (0)20 8242 4055</a>
                  </div>
                </div>
              </div>
            </GlassCard>

            <GlassCard padding="lg">
              <h3 class="text-heading-xs font-semibold mb-4">Response Time</h3>
              <p class="text-body-sm text-content-secondary">
                We aim to respond to all enquiries within one working day. For urgent matters, please indicate this in your message.
              </p>
            </GlassCard>

          </div>
        </ScrollReveal>
      </div>
    </Container>
  </Section>
</PageLayout>
