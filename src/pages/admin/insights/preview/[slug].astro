---
import InsightLayout from '@layouts/InsightLayout.astro';
import { getInsightBySlugFresh } from '@content/data/insights/index';

export const prerender = false;

const { slug } = Astro.params;
const article = getInsightBySlugFresh(slug!);

if (!article) {
  return Astro.redirect('/admin/insights');
}
---

<!-- Preview banner -->
<div class="fixed top-0 left-0 right-0 z-50 bg-amber-500/90 text-black text-center py-2 text-body-sm font-semibold">
  PREVIEW MODE — This page is not indexed
</div>

<InsightLayout article={article} />
