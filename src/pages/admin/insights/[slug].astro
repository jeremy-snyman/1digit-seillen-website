---
import AdminLayout from '@layouts/AdminLayout.astro';
import ArticleEditor from '@components/admin/ArticleEditor';
import { getInsightBySlugFresh } from '@content/data/insights/index';

export const prerender = false;

const { slug } = Astro.params;
const article = getInsightBySlugFresh(slug!);

if (!article) {
  return Astro.redirect('/admin/insights');
}
---

<AdminLayout title={`Edit — ${article.title}`}>
  <ArticleEditor client:load initial={article} />
</AdminLayout>
